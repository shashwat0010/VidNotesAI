# ==============================================================================
# 🌟 VidNotes AI - Frontend Environment Sample (.env.example)
# ==============================================================================
# Copy this file to 'frontend/.env.local' and paste your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 1. SUPABASE AUTHENTICATION
# ------------------------------------------------------------------------------
# In your Supabase Project: Project Settings -> API
# Paste your Project URL and Anon (Public) Key here:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 🌐 2. BACKEND API ENDPOINT
# ------------------------------------------------------------------------------
# In local development: http://localhost:8000/api/v1
# In production: https://your-backend-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
