# ==============================================================================
# 🌟 VidNotes AI - Master Environment Configuration Sample (.env.example)
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env' and 'frontend/.env.local')
# and replace placeholder values with your actual API credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 1. SUPABASE AUTHENTICATION & DATABASE (Recommended)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard: Project Settings -> API
# Required for Frontend Supabase Auth (Google, GitHub, Email/Password):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Backend JWT Verification & Service Role
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 🧠 2. OPENROUTER & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Direct LLM API Keys (fallback providers):
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 🗄️ 3. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Render)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (can be from Supabase, Render, Neon, or local):
DATABASE_URL=postgresql://your_db_user:your_db_password@your-db-host.com:5432/your_db_name
USE_SQLITE=False

# Individual PostgreSQL connection parameters (optional if DATABASE_URL is set):
POSTGRES_SERVER=your-db-host.com
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 🛡️ 4. APPLICATION SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=supersecretkey_vidnotes_ai_production_change_me_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# ☁️ 5. STORAGE (AWS S3 or MinIO)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=vid-notes-storage
S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# ⚡ 6. CELERY & REDIS
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 🌐 7. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
