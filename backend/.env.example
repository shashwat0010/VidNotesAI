# ==============================================================================
# 🌟 VidNotes AI - Backend Environment Sample (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 1. SUPABASE AUTH & BACKEND VERIFICATION (Optional)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 🧠 2. OPENROUTER LLM CONFIGURATION
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Direct LLM API Keys:
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 🛡️ 3. SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=supersecretkey_vidnotes_ai_production_change_me_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 🗄️ 4. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://your_db_user:your_db_password@your-db-host.com:5432/your_db_name
USE_SQLITE=False
POSTGRES_SERVER=your-db-host.com
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# ⚡ 5. CELERY & REDIS
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# ☁️ 6. STORAGE (AWS S3)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=vid-notes-storage
S3_ENDPOINT_URL=
